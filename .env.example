# Copy to .env for local development. Every value is a local placeholder.
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Phase 02 identity/session persistence. Memory is for local/test use; production rejects it.
AUTH_PERSISTENCE=postgres
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# Database and JWT/session controls. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/congdongngonngu
JWT_ACCESS_SECRET=replace-with-a-local-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-local-random-refresh-secret
SESSION_STORE=disabled
SESSION_SECRET=

# OAuth is disabled until its approved identity phase.
OAUTH_PROVIDER=disabled
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=

# CongDongNgonNgu-owned OAuth providers. Each provider is independently
# disabled or configured; secrets never reach the browser.
GOOGLE_OAUTH_PROVIDER=disabled
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=openid,email,profile
FACEBOOK_OAUTH_PROVIDER=disabled
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=
ZALO_OAUTH_PROVIDER=disabled
ZALO_OAUTH_CLIENT_ID=
ZALO_OAUTH_CLIENT_SECRET=
ZALO_OAUTH_REDIRECT_URI=
APPLE_OAUTH_PROVIDER=disabled
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_REDIRECT_URI=

# Optional providers are disabled by default. A configured provider requires
# its complete independent URL and credential set at application startup.
AI_PROVIDER=disabled
AI_API_URL=
AI_API_KEY=

EMAIL_PROVIDER=disabled
EMAIL_API_URL=
EMAIL_API_KEY=

STORAGE_PROVIDER=disabled
STORAGE_API_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

REALTIME_PROVIDER=disabled
REALTIME_API_URL=
REALTIME_API_KEY=
REDIS_URL=

PAYMENT_PROVIDER=disabled
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
